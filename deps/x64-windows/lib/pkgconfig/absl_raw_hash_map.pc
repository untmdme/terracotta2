prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: absl_raw_hash_map
Description: Abseil raw_hash_map library
URL: https://abseil.io/
Version: 20260107

Libs: "-L${libdir}"
Requires: absl_config = 20260107, absl_common_policy_traits = 20260107, absl_container_memory = 20260107, absl_core_headers = 20260107, absl_raw_hash_set = 20260107, absl_type_traits = 20260107, absl_throw_delegate = 20260107
Cflags: "-I${includedir}" /W3 /bigobj /wd4005 /wd4068 /wd4180 /wd4503 /wd4800 /DNOMINMAX /DWIN32_LEAN_AND_MEAN /D_CRT_SECURE_NO_WARNINGS /D_SCL_SECURE_NO_WARNINGS /D_ENABLE_EXTENDED_ALIGNED_STORAGE
