prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: absl_crc32c
Description: Abseil crc32c library
URL: https://abseil.io/
Version: 20260107

Libs: "-L${libdir}" -labsl_crc32c
Requires: absl_crc_cpu_detect = 20260107, absl_crc_internal = 20260107, absl_non_temporal_memcpy = 20260107, absl_config = 20260107, absl_core_headers = 20260107, absl_endian = 20260107, absl_prefetch = 20260107, absl_str_format = 20260107, absl_strings = 20260107
Cflags: "-I${includedir}" /W3 /bigobj /wd4005 /wd4068 /wd4180 /wd4503 /wd4800 /DNOMINMAX /DWIN32_LEAN_AND_MEAN /D_CRT_SECURE_NO_WARNINGS /D_SCL_SECURE_NO_WARNINGS /D_ENABLE_EXTENDED_ALIGNED_STORAGE
